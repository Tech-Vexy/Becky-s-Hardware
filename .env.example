# Supabase Single Store Hardware Store Configuration
# Provide your Supabase project URL and anon public key.
# Note: Service role key MUST NEVER be placed here or exposed to client-side PWA code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Store Operational Configuration
NEXT_PUBLIC_STORE_NAME="Becky's Hardware Store"
NEXT_PUBLIC_STORE_LOCATION=""
NEXT_PUBLIC_STORE_PHONE="+254 712 345 678"
NEXT_PUBLIC_STORE_KRA_PIN="P051234567X"
NEXT_PUBLIC_CURRENCY="KES"
NEXT_PUBLIC_DEFAULT_VAT_PERCENT=16

# Email Dispatcher (Resend API for Daily Reports & Instant Store Alerts)
RESEND_API_KEY=re_your_api_key_here
STORE_OWNER_EMAIL=eveliaveldrine@gmail.com
RESEND_FROM_EMAIL="Becky's Hardware Store <onboarding@resend.dev>"
RESEND_REPLY_TO="eveliaveldrine@gmail.com"

# Pusher Channels Realtime Configuration (pusher-js)
NEXT_PUBLIC_PUSHER_KEY="your_pusher_app_key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_SECRET="your_pusher_app_secret"
